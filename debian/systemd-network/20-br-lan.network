# The client segment. Every Hyper-V VM on the Private switch lives here and
# uses 10.10.0.1 as its default gateway.
#
# No DHCP server: clients are statically addressed by design, which is why the
# firewall intercepts their DNS instead of handing it to them. A client that
# sets its resolver to 8.8.8.8 by hand still gets answered by the resolver
# belonging to its own tunnel.

[Match]
Name=br-lan

[Network]
Address=10.10.0.1/24
# Nothing about this interface may reach the internet on its own.
IPv6AcceptRA=no
LinkLocalAddressing=no
DHCP=no
IPForward=no
